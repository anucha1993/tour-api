<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Remove WebDAV so it doesn't intercept OPTIONS preflight requests -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <!-- Ensure OPTIONS requests are handled by PHP, not IIS -->
      <remove name="OPTIONSVerbHandler" />
      <!-- Allow all HTTP verbs (GET, POST, PUT, PATCH, DELETE, OPTIONS) through PHP -->
      <remove name="PHP-php" />
      <add name="PHP-php" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\Program Files (x86)\Plesk\Additional\PleskPHP82\php-cgi.exe"
           resourceType="Either" requireAccess="Script" />
    </handlers>

    <!-- IIS-level CORS headers as fallback (in case request doesn't reach Laravel) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- URL Rewrite: route all requests through index.php + handle OPTIONS preflight -->
    <rewrite>
      <rules>
        <!-- Force OPTIONS preflight to go through index.php (Laravel CORS middleware) -->
        <rule name="Handle OPTIONS Preflight" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
        <rule name="Redirect Trailing Slashes" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <rule name="Send Requests To Front Controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
